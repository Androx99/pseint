//Suma 5 numeros sin bucles
Algoritmo Suma5
	//Variables a Definir 
	Definir n1,n2,n3,n4,n5,suma Como Entero;
	Escribir "Introduce 5 numeros"; //Entrada
	Leer n1,n2, n3, n4, n5; //Salida
	suma = n1+n2+n3+n4+n5; //Suma de los numeros
	Escribir "El resutado es: " suma; 
FinAlgoritmo
